{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    // ======================
    // 1. 编排规划与验证系列
    // ======================
    "sisyphus": {
      // 主编排器：委托任务编排分配、TODO、后台并行、动态组合技能，调用subagent
      // fallback：gpt-5.6-terra → claude-opus-4-7 → gpt-5.3-codex
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": [
        "openai/gpt-5.6-terra",
        "anthropic/claude-opus-4-7",
        "openai/gpt-5.3-codex"
      ],
      // 追加提示词：显式加载全局 AGENTS.md
      "prompt_append": "必须严格遵守 AGENTS.md 的要求: \nfile://~/.config/opencode/AGENTS.md"
    },
    "hephaestus": {
      // 深度自主工作专用，长周期，深度任务
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": [
        "openai/gpt-5.6-terra",
        "anthropic/claude-opus-4-7"
      ],
      "prompt_append": "必须严格遵守 AGENTS.md 的要求: \nfile://~/.config/opencode/AGENTS.md"
    },
    "oracle": {
      // 咨询/调试/架构专家：代码审查、复杂问题拆解，交互式问答
      // fallback：gpt-5.6-sol → claude-opus-4-7 → gpt-5.3-codex
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "fallback_models": [
        "anthropic/claude-opus-4-7",
        "openai/gpt-5.3-codex"
      ],
      "prompt_append": "必须严格遵守 AGENTS.md 的要求: \nfile://~/.config/opencode/AGENTS.md"
    },
    "librarian": {
      "model": "openai/gpt-5.6-luna",
      "fallback_models": [
        "anthropic/claude-haiku-4-5"
      ],
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "lsp": "allow",
        "context7_*": "allow",
        "exa_*": "allow",
        "gh_grep_*": "allow",
        "grep_app_*": "allow",
        "deepwiki_*": "allow",
        "mcp-deepwiki_*": "allow",
        "session_*": "allow"
      },
      "variant": "low",
      "prompt_append": "必须严格遵守 AGENTS.md 的要求: \nfile://~/.config/opencode/AGENTS.md"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "fallback_models": [
        "anthropic/claude-haiku-4-5"
      ],
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "lsp": "allow",
        "context7_*": "allow",
        "exa_*": "allow",
        "gh_grep_*": "allow",
        "grep_app_*": "allow",
        "deepwiki_*": "allow",
        "mcp-deepwiki_*": "allow",
        "session_*": "allow"
      },
      "variant": "low",
      "prompt_append": "必须严格遵守 AGENTS.md 的要求: \nfile://~/.config/opencode/AGENTS.md"
    },
    "multimodal-looker": {
      // 多模态分析：图片、PDF等
      // fallback：gpt-5.6-terra → claude-sonnet-4-6 → gpt-5.3-codex
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": [
        "openai/gpt-5.6-terra",
        "anthropic/claude-sonnet-4-6",
        "openai/gpt-5.3-codex"
      ],
      "prompt_append": "必须严格遵守 AGENTS.md 的要求: \nfile://~/.config/opencode/AGENTS.md"
    },
    "prometheus": {
      // 战略规划：澄清需求、验证计划、复杂任务分解，推荐内部plan而不是和用户直接交互
      // fallback：claude-opus-4-7
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "fallback_models": [
        "anthropic/claude-opus-4-7"
      ],
      "prompt_append": "必须严格遵守 AGENTS.md 的要求: \nfile://~/.config/opencode/AGENTS.md"
    },
    "metis": {
      // 预分析规划顾问：正式plan/执行前进行问题理解、风险与上下文分析，温度略高，探索更多方案
      // fallback：claude-opus-4-7
      "model": "openai/gpt-5.6-sol",
      "fallback_models": [
        "anthropic/claude-opus-4-7"
      ],
      "variant": "high",
      "prompt_append": "必须严格遵守 AGENTS.md 的要求: \nfile://~/.config/opencode/AGENTS.md"
    },
    "momus": {
      // 计划与结果验证：对计划/方案进行合理性检查和评审
      // fallback：claude-opus-4-7 → gpt-5.3-codex
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "fallback_models": [
        "anthropic/claude-opus-4-7",
        "openai/gpt-5.3-codex"
      ],
      "prompt_append": "必须严格遵守 AGENTS.md 的要求: \nfile://~/.config/opencode/AGENTS.md"
    },
    "atlas": {
      // 高级编排器：全生命周期管理，任务路由，基于skills调度，全局会话级别的编排器，一般由内部逻辑/hook唤起
      "model": "anthropic/claude-sonnet-4-6",
      "variant": "high",
      "prompt_append": "必须严格遵守 AGENTS.md 的要求: \nfile://~/.config/opencode/AGENTS.md\n仅做当前阶段所必需的最小修改，禁止无关改动、顺手重构和范围扩散。\n任务必须分阶段执行，每次只完成一个清晰、可验证的阶段目标。\n每个阶段完成后，必须先提交一个最小、完整、自洽的 commit，再进入下一阶段。\n禁止将多个阶段合并到同一个 commit 中。"
    },
    "sisyphus-junior": {
      "model": "openai/gpt-5.5",
      "fallback_models": [
        "openai/gpt-5.6-terra",
        "openai/gpt-5.3-codex"
      ],
      "variant": "high",
      "prompt_append": "必须严格遵守 AGENTS.md 的要求: \nfile://~/.config/opencode/AGENTS.md"
    }
  },
  "categories": {
    "visual-engineering": {
      // 视觉/前端/GUI：gpt-5.5 → gpt-5.6-terra → opus
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": [
        "openai/gpt-5.6-terra",
        "anthropic/claude-opus-4-7"
      ],
      "description": "Frontend, UI/UX, design, styling, animations, layout work",
      "prompt_append": "必须严格遵守 AGENTS.md 的要求: \nfile://~/.config/opencode/AGENTS.md"
    },
    "ultrabrain": {
      // 超大脑：gpt-5.6-sol → opus → codex
      "model": "openai/gpt-5.6-sol",
      "variant": "xhigh",
      "fallback_models": [
        "anthropic/claude-opus-4-7",
        "openai/gpt-5.3-codex"
      ],
      "description": "Complex logic, architecture decisions, algorithms, deep reasoning",
      "prompt_append": "必须严格遵守 AGENTS.md 的要求: \nfile://~/.config/opencode/AGENTS.md"
    },
    "deep": {
      // 深度执行：gpt-5.5 → gpt-5.6-terra → opus → codex
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": [
        "openai/gpt-5.6-terra",
        "anthropic/claude-opus-4-7",
        "openai/gpt-5.3-codex"
      ],
      "description": "Autonomous problem-solving, thorough research, end-to-end implementation",
      "prompt_append": "必须严格遵守 AGENTS.md 的要求: \nfile://~/.config/opencode/AGENTS.md"
    },
    "artistry": {
      // 创意解法：非常规思路解决复杂问题
      "model": "openai/gpt-5.6-sol",
      "fallback_models": [
        "anthropic/claude-opus-4-7",
        "openai/gpt-5.3-codex"
      ],
      "variant": "xhigh",
      "description": "Complex problem-solving with unconventional, creative approaches - beyond standard patterns",
      "prompt_append": "必须严格遵守 AGENTS.md 的要求: \nfile://~/.config/opencode/AGENTS.md"
    },
    "quick": {
      // 快速小活：gpt-5.6-luna → haiku
      "model": "openai/gpt-5.6-luna",
      "variant": "low",
      "fallback_models": [
        "anthropic/claude-haiku-4-5"
      ],
      "description": "Trivial tasks, single-file changes, typo fixes, simple modifications",
      "prompt_append": "必须严格遵守 AGENTS.md 的要求: \nfile://~/.config/opencode/AGENTS.md"
    },
    "unspecified-low": {
      "model": "openai/gpt-5.5",
      "fallback_models": [
        "openai/gpt-5.6-terra",
        "openai/gpt-5.3-codex",
        "anthropic/claude-sonnet-4-6"
      ],
      "variant": "medium",
      "description": "General tasks, low to moderate effort",
      "prompt_append": "必须严格遵守 AGENTS.md 的要求: \nfile://~/.config/opencode/AGENTS.md"
    },
    "unspecified-high": {
      "model": "openai/gpt-5.5",
      "fallback_models": [
        "openai/gpt-5.6-terra",
        "anthropic/claude-opus-4-7",
        "openai/gpt-5.3-codex"
      ],
      "variant": "high",
      "description": "General tasks, high effort and complexity",
      "prompt_append": "必须严格遵守 AGENTS.md 的要求: \nfile://~/.config/opencode/AGENTS.md"
    },
    "writing": {
      "model": "openai/gpt-5.5",
      "fallback_models": [
        "openai/gpt-5.6-terra",
        "openai/gpt-5.3-codex",
        "anthropic/claude-sonnet-4-6"
      ],
      "description": "Documentation, prose, technical writing, creative content",
      "prompt_append": "必须严格遵守 AGENTS.md 的要求: \nfile://~/.config/opencode/AGENTS.md"
    }
  },
  "sisyphus_agent": {
    "disabled": false,
    "default_builder_enabled": false,
    "planner_enabled": true,
    "replace_plan": true,
    "tdd": false
  },
  "git_master": {
    "commit_footer": false,
    "include_co_authored_by": false,
    "git_env_prefix": ""
  },
  "notification": {
    "force_enable": true
  },
  "team_mode": {
    "enabled": false,
    "tmux_visualization": false,
    "max_parallel_members": 4,
    "max_members": 8,
    "max_messages_per_run": 10000,
    "max_wall_clock_minutes": 120,
    "max_member_turns": 500,
    "message_payload_max_bytes": 32768,
    "recipient_unread_max_bytes": 262144,
    "mailbox_poll_interval_ms": 3000
  },
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [
      429,
      500,
      502,
      503,
      504,
      529
    ],
    "max_fallback_attempts": 3,
    "cooldown_seconds": 60,
    "timeout_seconds": 20,
    "notify_on_fallback": true
  },
  "hashline_edit": true,
  "model_capabilities": {
    "enabled": false
  },
  "codegraph": {
    "enabled": true,
    "auto_init": true,
    "auto_provision": true,
    "daemon": true
  }
}
