{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "anthropic": {
      "npm": "@ai-sdk/anthropic",
      "name": "anthropic",
      "options": {
        "baseURL": "{env:ANTHROPIC_BASE_URL}/v1",
        "apiKey": "{env:ANTHROPIC_AUTH_TOKEN}",
        "disableMaxOutputTokens": true,
        "setCacheKey": true
      },
      "whitelist": [
        "claude-sonnet-4-6",
        "claude-opus-4-6",
        "claude-opus-4-7",
        "claude-haiku-4-5"
      ],
      "models": {
        "claude-opus-4-7": {
          "name": "claude-opus-4-7",
          "attachment": false,
          "limit": {
            "context": 200000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 16000
            }
          },
          "variants": {
            "low": {
              "effort": "low"
            },
            "medium": {
              "effort": "high"
            },
            "high": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 32000
              }
            },
            "xhigh": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 128000
              },
              "speed": "fast"
            }
          }
        },
        "claude-opus-4-6": {
          "name": "claude-opus-4-6",
          "attachment": false,
          "limit": {
            "context": 200000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 16000
            }
          },
          "variants": {
            "low": {
              "effort": "low"
            },
            "medium": {
              "effort": "high"
            },
            "high": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 32000
              }
            },
            "xhigh": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 128000
              },
              "speed": "fast"
            }
          }
        },
        "claude-sonnet-4-6": {
          "name": "claude-sonnet-4-6",
          "attachment": false,
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 16000
            }
          },
          "variants": {
            "low": {
              "effort": "low"
            },
            "medium": {
              "effort": "high"
            },
            "high": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 16000
              }
            },
            "xhigh": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 64000
              }
            }
          }
        },
        "claude-haiku-4-5": {
          "name": "claude-haiku-4-5",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "effort": "low"
            },
            "medium": {
              "effort": "high"
            },
            "high": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 8000
              }
            },
            "xhigh": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 16000
              }
            }
          }
        }
      }
    },
    "openai": {
      "name": "openai",
      "npm": "@ai-sdk/openai",
      "api": "responses",
      "options": {
        "baseURL": "{env:OPENAI_BASE_URL}",
        "apiKey": "{env:OPENAI_AUTH_TOKEN}",
        "disableMaxOutputTokens": true,
        "truncation": "auto",
        "headerTimeout": 60000,
        "timeout": 600000,
        "chunkTimeout": 60000
      },
      "whitelist": [
        "gpt-5.5",
        "gpt-5.6-sol",
        "gpt-5.6-terra",
        "gpt-5.6-luna"
      ],
      "models": {
        "gpt-5.5": {
          "limit": {
            "context": 200000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "gpt-5.5",
          "interleaved": {
            "field": "reasoning_content"
          },
          "variants": {
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            }
          }
        },
        "gpt-5.6-sol": {
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "gpt-5.6-sol",
          "interleaved": {
            "field": "reasoning_content"
          },
          "cost": {
            "input": 5,
            "output": 30,
            "cache_read": 0.5
          },
          "reasoning": true,
          "tool_call": true,
          "variants": {
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            }
          }
        },
        "gpt-5.6-terra": {
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "gpt-5.6-terra",
          "interleaved": {
            "field": "reasoning_content"
          },
          "cost": {
            "input": 2.5,
            "output": 15,
            "cache_read": 0.25
          },
          "reasoning": true,
          "tool_call": true,
          "variants": {
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            }
          }
        },
        "gpt-5.6-luna": {
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "gpt-5.6-luna",
          "interleaved": {
            "field": "reasoning_content"
          },
          "cost": {
            "input": 1,
            "output": 6,
            "cache_read": 0.1
          },
          "reasoning": true,
          "tool_call": true,
          "variants": {
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            }
          }
        }
      }
    }
  },
  "compaction": {
    "auto": false,
    "prune": false
  },
  "mcp": {
    "serena": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--open-web-dashboard",
        "false",
        "--project-from-cwd"
      ]
    },
    "sequential-thinking": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "exa": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "exa-mcp-server"
      ]
    },
    "context7": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "memory": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "deepwiki": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "gh_grep": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.grep.app"
    },
    "mise": {
      "type": "local",
      "enabled": true,
      "command": [
        "mise",
        "mcp"
      ],
      "environment": {
        "MISE_EXPERIMENTAL": "1"
      }
    }
  },
  "plugin": [
    "opencode-axonhub-tracing@1.1.0",
    "@snubisks/opencode-dcp@3.1.14",
    "oh-my-openagent@v4.19.2"
  ],
  "share": "disabled",
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "*.log"
    ]
  },
  "agent": {
    "plan": {
      "disable": true
    },
    "build": {
      "disable": true
    }
  },
  "autoupdate": "notify",
  "logLevel": "INFO",
  "enabled_providers": [
    "openai",
    "anthropic"
  ],
  "username": "xyuzou",
  "small_model": "openai/gpt-5.6-luna",
  "permission": {
    // Baseline: unknown capabilities ask by default. Specific safe tools are allowed below.
    "bash": {
      "*": "ask",
      // Local read-only inspection and verification.
      "pwd": "allow",
      "sleep *": "ask",
      "ls *": "allow",
      "find *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "sed *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "diff *": "allow",
      "jq *": "allow",
      "yq *": "allow",
      "echo *": "allow",
      "curl *": "allow",
      "go *": "allow",
      "gofmt *": "allow",
      "pnpm run *": "allow",
      "npm list *": "allow",
      "pip list *": "allow",
      "python *": "allow",
      "dpkg *": "allow",
      "php *": "allow",
      "tmux": "allow",
      "tmux *": "allow",
      "gh *": "ask",
      "gh -h": "allow",
      "gh --help": "allow",
      "gh help *": "allow",
      "gh status": "allow",
      "gh status *": "allow",
      // notice gh auth status can't be allow by *, so we need to specify it explicitly.
      "gh auth status": "allow",
      "gh auth status --json hosts": "allow",
      // Common read-only GitHub CLI commands.
      "gh search code *": "allow",
      "gh search commits *": "allow",
      "gh search issues *": "allow",
      "gh search prs *": "allow",
      "gh search repos *": "allow",
      "gh repo view *": "allow",
      "gh repo list *": "allow",
      "gh repo ls *": "allow",
      "gh repo read-file *": "allow",
      "gh repo gitignore list *": "allow",
      "gh repo gitignore view *": "allow",
      "gh repo license list *": "allow",
      "gh repo license view *": "allow",
      "gh repo autolink list *": "allow",
      "gh repo autolink view *": "allow",
      "gh repo deploy-key list *": "allow",
      "gh pr view *": "allow",
      "gh pr list *": "allow",
      "gh pr ls *": "allow",
      "gh pr diff *": "allow",
      "gh pr status *": "allow",
      "gh pr checks *": "allow",
      "gh pr comment *": "allow",
      "gh pr edit *": "allow",
      "gh issue create *": "allow",
      "gh issue view *": "allow",
      "gh issue list *": "allow",
      "gh discussion view *": "allow",
      "gh issue status *": "allow",
      "gh release view *": "allow",
      "gh release list *": "allow",
      "gh release ls *": "allow",
      "gh release verify *": "allow",
      "gh release verify-asset *": "allow",
      "gh run view *": "allow",
      "gh run list *": "allow",
      "gh run ls *": "allow",
      "gh workflow view *": "allow",
      "gh workflow list *": "allow",
      "gh workflow ls *": "allow",
      "gh label list *": "allow",
      "gh alias list *": "allow",
      "gh skill list *": "allow",
      "gh skill search *": "allow",
      "gh skill preview *": "allow",
      "gh api repos/*": "allow",
      "gh api search/*": "allow",
      "gh api graphql --method GET *": "allow",
      "gh api graphql -X GET *": "allow",
      "gh api repos/* --method GET *": "allow",
      "gh api repos/* -X GET *": "allow",
      "gh api search/* --method GET *": "allow",
      "gh api search/* -X GET *": "allow",
      "kubectl get *": "allow",
      "kubectl describe *": "allow",
      "kubectl logs *": "allow",
      "docker ps *": "allow",
      "docker logs *": "allow",
      "docker images *": "allow",
      "docker manifest inspect *": "allow",
      "docker build *": "allow",
      "git show *": "allow",
      "git show-ref *": "allow",
      "git status *": "allow",
      "git remote -v": "allow",
      "git remote show *": "allow",
      "git rev-parse *": "allow",
      "git merge-base *": "allow",
      "git branch -vv": "allow",
      "git branch --show-current *": "allow",
      "git branch --list *": "allow",
      "git reset *": "allow",
      "git diff *": "allow",
      "git fetch *": "allow",
      "git stash *": "allow",
      "base64 -d": "allow",
      "nl -ba": "allow",
      // opencode related commands.
      "opencode --version": "allow",
      "opencode models": "allow",
      // Commands that can change files, dependencies, infrastructure, or external state.
      "cp *": "ask",
      "mv *": "ask",
      "mkdir *": "ask",
      "tee *": "ask",
      "npx *": "ask",
      "bunx *": "ask",
      "npm install *": "ask",
      "npm uninstall *": "ask",
      "npm publish *": "deny",
      "npm link *": "ask",
      "pnpm add *": "ask",
      "pnpm remove *": "ask",
      "pip install *": "ask",
      "pip uninstall *": "ask",
      "docker run *": "ask",
      "docker exec *": "ask",
      "docker rm *": "ask",
      "docker rmi *": "ask",
      "docker stop *": "ask",
      "docker kill *": "ask",
      "docker volume rm *": "ask",
      "docker network rm *": "ask",
      "kubectl apply *": "ask",
      "kubectl delete *": "ask",
      "kubectl exec *": "ask",
      "kubectl edit *": "ask",
      "kubectl patch *": "ask",
      "kubectl scale *": "ask",
      "kubectl cordon *": "ask",
      "helm *": "ask",
      "helm lint *": "allow",
      "helm version *": "allow",
      "helm template *": "allow",
      "helm dependency build *": "allow",
      "rm -r *": "ask",
      "rm *": "ask",
      "rmdir *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "sudo *": "ask",
      "sudo chmod *": "ask",
      "sudo chown *": "ask",
      "sudo systemctl *": "ask",
      "sudo apt *": "ask",
      // Destructive or privilege-sensitive commands stay denied even if broader ask rules match earlier.
      "git push *": "ask",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git reset --hard *": "deny",
      "git clean -fdx *": "deny",
      "git clean -fd *": "ask",
      "git branch -D *": "ask",
      "git rebase *": "ask",
      "git cherry-pick *": "ask",
      "git add *": "allow",
      "git commit *": "allow",
      "git mergse *": "allow",
      "git log *": "allow",
      "git switch *": "allow",
      "git ls-remote *": "allow",
      "git worktree add *": "allow",
      "git worktree list *": "allow",
      "git worktree prune *": "allow",
      "git check-ignore *": "allow",
      "git apply *": "allow",
      "git tag *": "allow",
      "git tag -d *": "deny",
      "git tag --delete *": "deny",
      "git for-each-ref *": "allow",
      "docker system prune *": "deny",
      "kubectl drain *": "deny",
      "gh auth token *": "deny",
      "gh auth logout *": "deny",
      "gh repo delete *": "deny",
      "gh repo archive *": "deny",
      "gh issue delete *": "deny",
      "gh release delete *": "deny",
      "gh release delete-asset *": "deny",
      "gh run delete *": "deny",
      "gh project delete *": "deny",
      "gh project field-delete *": "deny",
      "gh project item-delete *": "deny",
      "gh ssh-key delete *": "deny",
      "gh gpg-key delet e*": "deny",
      "rm -rf *": "deny",
      "sudo rm *": "deny",
      "ansible-playbook": "ask",
      "ansible-playbook --syntax-check *": "allow",
      "mise *": "ask",
      "mise ls *": "allow",
      "true": "allow",
      "command -v *": "allow",
      "golangci-lint *": "allow",
      "gcx login *": "deny",
      "golangci-lint *": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.key": "deny",
      "*.pem": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.secret": "deny",
      "*secret*": "deny",
      "*token*": "deny",
      "*credential*": "deny",
      "*password*": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*kubeconfig*": "deny",
      ".git/config": "deny",
      "credentials/**": "deny",
      "*/credentials/**": "deny",
      "*/.ssh/**": "deny",
      "*/.gnupg/**": "deny",
      "*/secrets/**": "deny"
    },
    "glob": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.key": "deny",
      "*.pem": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.secret": "deny",
      "*secret*": "deny",
      "*token*": "deny",
      "*credential*": "deny",
      "*password*": "deny",
      "credentials/**": "deny",
      "*/credentials/**": "deny",
      "*/.ssh/**": "deny",
      "*/.gnupg/**": "deny",
      "*/secrets/**": "deny"
    },
    "grep": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.key": "deny",
      "*.pem": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.secret": "deny",
      "*secret*": "deny",
      "*token*": "deny",
      "*credential*": "deny",
      "*password*": "deny",
      "credentials/**": "deny",
      "*/credentials/**": "deny",
      "*/.ssh/**": "deny",
      "*/.gnupg/**": "deny",
      "*/secrets/**": "deny"
    },
    "edit": {
      "*": "ask",
      "opencode/**": "allow",
      "AGENTS.md": "allow",
      "~/.config/opencode/**": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.key": "deny",
      "*.pem": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.secret": "deny",
      "*secret*": "deny",
      "*token*": "deny",
      "*credential*": "deny",
      "*password*": "deny",
      "credentials/**": "deny",
      "*/credentials/**": "deny",
      "*/.ssh/**": "deny",
      "*/secrets/**": "deny"
    },
    "write": {
      "*": "ask",
      "opencode/**": "allow",
      "AGENTS.md": "allow",
      "~/.config/opencode/**": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.key": "deny",
      "*.pem": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.secret": "deny",
      "*secret*": "deny",
      "*token*": "deny",
      "*credential*": "deny",
      "*password*": "deny",
      "credentials/**": "deny",
      "*/credentials/**": "deny",
      "*/.ssh/**": "deny",
      "*/secrets/**": "deny"
    },
    "interactive_bash": "ask",
    "mise_*": "ask",
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/.agents/skills/**": "allow",
      "~/.cache/oh-my-opencode/**": "allow",
      "/tmp/opencode/**": "allow"
    }
  },
  "formatter": {
    "gofmt": {
      "command": [
        "gofmt",
        "-w",
        "$FILE"
      ],
      "extensions": [
        ".go"
      ]
    },
    "shfmt": {
      "command": [
        "shfmt",
        "-w",
        "$FILE"
      ],
      "extensions": [
        ".sh",
        ".bash"
      ]
    },
    "prettier": {
      "command": [
        "npx",
        "prettier",
        "--write",
        "$FILE"
      ],
      "extensions": [
        ".yaml",
        ".yml",
        ".md"
      ]
    }
  }
}
