{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "anthropic": {
      "npm": "@ai-sdk/anthropic",
      "name": "anthropic",
      "options": {
        "baseURL": "{env:ANTHROPIC_BASE_URL}/v1",
        "apiKey": "{env:ANTHROPIC_AUTH_TOKEN}",
        "disableMaxOutputTokens": true,
        "setCacheKey": true
      },
      "whitelist": [
        "claude-sonnet-4-6",
        "claude-opus-4-6",
        "claude-opus-4-7",
        "claude-haiku-4-5"
      ],
      "models": {
        "claude-opus-4-7": {
          "name": "claude-opus-4-7",
          "attachment": false,
          "limit": {
            "context": 200000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 16000
            }
          },
          "variants": {
            "low": {
              "effort": "low"
            },
            "medium": {
              "effort": "high"
            },
            "high": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 32000
              }
            },
            "xhigh": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 128000
              },
              "speed": "fast"
            }
          }
        },
        "claude-opus-4-6": {
          "name": "claude-opus-4-6",
          "attachment": false,
          "limit": {
            "context": 200000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 16000
            }
          },
          "variants": {
            "low": {
              "effort": "low"
            },
            "medium": {
              "effort": "high"
            },
            "high": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 32000
              }
            },
            "xhigh": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 128000
              },
              "speed": "fast"
            }
          }
        },
        "claude-sonnet-4-6": {
          "name": "claude-sonnet-4-6",
          "attachment": false,
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 16000
            }
          },
          "variants": {
            "low": {
              "effort": "low"
            },
            "medium": {
              "effort": "high"
            },
            "high": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 16000
              }
            },
            "xhigh": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 64000
              }
            }
          }
        },
        "claude-haiku-4-5": {
          "name": "claude-haiku-4-5",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "effort": "low"
            },
            "medium": {
              "effort": "high"
            },
            "high": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 8000
              }
            },
            "xhigh": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 16000
              }
            }
          }
        }
      }
    },
    "openai": {
      "name": "openai",
      "npm": "@ai-sdk/openai",
      "api": "responses",
      "options": {
        "baseURL": "{env:OPENAI_BASE_URL}",
        "apiKey": "{env:OPENAI_AUTH_TOKEN}",
        "disableMaxOutputTokens": true,
        "truncation": "auto",
        "headerTimeout": 60000,
        "timeout": 600000,
        "chunkTimeout": 60000
      },
      "whitelist": [
        "gpt-5.2",
        "gpt-5.5",
        "gpt-5.4-mini",
        "gpt-5.3-codex",
        "gpt-5.3-codex-spark"
      ],
      "models": {
        "gpt-5.2": {
          "limit": {
            "context": 400000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "gpt-5.2",
          "interleaved": {
            "field": "reasoning_content"
          },
          "variants": {
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            }
          }
        },
        "gpt-5.5": {
          "limit": {
            "context": 200000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "gpt-5.5",
          "interleaved": {
            "field": "reasoning_content"
          },
          "variants": {
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            }
          }
        },
        "gpt-5.4-mini": {
          "limit": {
            "context": 400000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "gpt-5.4-mini",
          "interleaved": {
            "field": "reasoning_content"
          },
          "variants": {
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            }
          }
        },
        "gpt-5.3-codex": {
          "limit": {
            "context": 400000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "gpt-5.3-codex",
          "interleaved": {
            "field": "reasoning_content"
          },
          "options": {
            "include": [
              "reasoning.encrypted_content"
            ],
            "store": false
          },
          "variants": {
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            }
          }
        },
        "gpt-5.3-codex-spark": {
          "name": "gpt-5.3-codex-spark",
          "limit": {
            "context": 128000,
            "output": 32000
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "options": {
        "store": false
      }
    },
    "plan": {
      "options": {
        "store": false
      }
    }
  },
  "compaction": {
    "auto": false,
    "prune": false
  },
  "mcp": {
    "serena": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--open-web-dashboard",
        "false",
        "--project-from-cwd"
      ]
    },
    "sequential-thinking": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "exa": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "exa-mcp-server"
      ]
    },
    "context7": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "memory": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "deepwiki": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "gh_grep": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.grep.app"
    },
    "mise": {
      "type": "local",
      "enabled": true,
      "command": [
        "mise",
        "mcp"
      ],
      "environment": {
        "MISE_EXPERIMENTAL": "1"
      }
    }
  },
  "plugin": [
    "opencode-axonhub-tracing@1.1.0",
    "@franlol/opencode-md-table-formatter@0.0.6",
    "@tarquinen/opencode-dcp@3.1.12",
    "oh-my-openagent@v4.7.5"
  ],
  "share": "disabled",
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "*.log"
    ]
  },
  "autoupdate": "notify",
  "logLevel": "INFO",
  "username": "xyuzou",
  "small_model": "openai/gpt-5.3-codex-spark",
  "permission": {
    // Baseline: unknown capabilities ask by default. Specific safe tools are allowed below.
    "shell": {
      "*": "ask",
      // Local read-only inspection and verification.
      "pwd": "allow",
      "ls *": "allow",
      "find *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "sed *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "diff *": "allow",
      "jq *": "allow",
      "echo *": "allow",
      "curl *": "allow",
      "go *": "allow",
      "gofmt *": "allow",
      "pnpm run *": "allow",
      "npm list *": "allow",
      "pip list *": "allow",
      "python *": "allow",
      "dpkg *": "allow",
      "php *": "allow",
      "tmux": "allow",
      "tmux *": "allow",
      "gh *": "ask",
      "gh -h": "allow",
      "gh --help": "allow",
      "gh help *": "allow",
      "gh status": "allow",
      "gh status *": "allow",
      "gh auth status --json hosts": "allow",
      // Common read-only GitHub CLI commands.
      "gh search code *": "allow",
      "gh search commits *": "allow",
      "gh search issues *": "allow",
      "gh search prs *": "allow",
      "gh search repos *": "allow",
      "gh repo view *": "allow",
      "gh repo list *": "allow",
      "gh repo ls *": "allow",
      "gh repo gitignore list *": "allow",
      "gh repo gitignore view *": "allow",
      "gh repo license list *": "allow",
      "gh repo license view *": "allow",
      "gh repo autolink list *": "allow",
      "gh repo autolink view *": "allow",
      "gh repo deploy-key list *": "allow",
      "gh pr view *": "allow",
      "gh pr list *": "allow",
      "gh pr ls *": "allow",
      "gh pr diff *": "allow",
      "gh pr status *": "allow",
      "gh pr checks *": "allow",
      "gh pr comment *": "allow",
      "gh issue create *": "allow",
      "gh issue view *": "allow",
      "gh issue list *": "allow",
      "gh issue status *": "allow",
      "gh release view *": "allow",
      "gh release list *": "allow",
      "gh release ls *": "allow",
      "gh release verify *": "allow",
      "gh release verify-asset *": "allow",
      "gh run view *": "allow",
      "gh run list *": "allow",
      "gh run ls *": "allow",
      "gh workflow view *": "allow",
      "gh workflow list *": "allow",
      "gh workflow ls *": "allow",
      "gh label list *": "allow",
      "gh alias list *": "allow",
      "gh skill list *": "allow",
      "gh skill search *": "allow",
      "gh skill preview *": "allow",
      "kubectl get *": "allow",
      "kubectl describe *": "allow",
      "kubectl logs *": "allow",
      "docker ps *": "allow",
      "docker logs *": "allow",
      "docker images *": "allow",
      "git show *": "allow",
      "git status *": "allow",
      "git remote -v": "allow",
      "git remote show": "allow",
      "git rev-parse *":"allow",
      "git merge-base *":"allow",

      "git branch -vv": "allow",
      "git diff *": "allow",
      "git fetch": "allow",
      // Commands that can change files, dependencies, infrastructure, or external state.
      "cp *": "ask",
      "mv *": "ask",
      "mkdir *": "ask",
      "tee *": "ask",
      "npx *": "ask",
      "bunx *": "ask",
      "npm install *": "ask",
      "npm uninstall *": "ask",
      "npm publish *": "deny",
      "npm link *": "ask",
      "pnpm add *": "ask",
      "pnpm remove *": "ask",
      "pip install *": "ask",
      "pip uninstall *": "ask",
      "docker run *": "ask",
      "docker exec *": "ask",
      "docker rm *": "ask",
      "docker rmi *": "ask",
      "docker stop *": "ask",
      "docker kill *": "ask",
      "docker volume rm *": "ask",
      "docker network rm *": "ask",
      "kubectl apply *": "ask",
      "kubectl delete *": "ask",
      "kubectl exec *": "ask",
      "kubectl edit *": "ask",
      "kubectl patch *": "ask",
      "kubectl scale *": "ask",
      "kubectl cordon *": "ask",
      "helm *": "ask",
      "helm install *": "ask",
      "helm upgrade *": "ask",
      "helm uninstall *": "ask",
      "helm delete *": "ask",
      "helm rollback *": "ask",
      "rm -r *": "ask",
      "rm *": "ask",
      "rmdir *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "sudo *": "ask",
      "sudo chmod *": "ask",
      "sudo chown *": "ask",
      "sudo systemctl *": "ask",
      "sudo apt *": "ask",
      // Destructive or privilege-sensitive commands stay denied even if broader ask rules match earlier.
      "git push *": "ask",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git reset --hard *": "deny",
      "git clean -fdx *": "deny",
      "git clean -fd *": "ask",
      "git branch -D *": "ask",
      "git rebase *": "ask",
      "git cherry-pick *": "ask",
      "git commit *": "ask",
      "git log *": "allow",
      "git tag *": "allow",
      "git tag -d *": "deny",
      "git tag --delete *": "deny",
      "git for-each-ref *": "allow",
      "docker system prune *": "deny",
      "kubectl drain *": "deny",
      "gh auth token*": "deny",
      "gh auth logout*": "deny",
      "gh repo delete*": "deny",
      "gh repo archive*": "deny",
      "gh issue delete*": "deny",
      "gh release delete*": "deny",
      "gh release delete-asset*": "deny",
      "gh run delete*": "deny",
      "gh project delete*": "deny",
      "gh project field-delete*": "deny",
      "gh project item-delete*": "deny",
      "gh ssh-key delete*": "deny",
      "gh gpg-key delete*": "deny",
      "rm -rf *": "deny",
      "sudo rm *": "deny",
      "ansible-playbook": "ask",
      "ansible-playbook --syntax-check *": "allow"
    },
    "bash": {
      "*": "ask",
      // Local read-only inspection and verification.
      "pwd": "allow",
      "ls *": "allow",
      "find *": "allow",
